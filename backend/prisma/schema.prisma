generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer                Customer?
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  subscriptionHistories   SubscriptionStatusHistory[]
  paymentsCreated         Payment[]

  @@index([email])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  name      String
  email     String   @unique
  company   String?
  address   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([email])
  @@index([name])
}

model Product {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("SERVICE") // SERVICE, PHYSICAL, DIGITAL
  salesPrice Float
  costPrice  Float
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants              ProductVariant[]
  subscriptionLines     SubscriptionLine[]
  templateLines         QuotationTemplateLine[]
  invoiceLines          InvoiceLine[]
  discountsApplied      Discount[]

  @@index([name])
  @@index([type])
  @@index([active])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  name            String   // e.g. "Brand: Odoo", "Size: Large"
  priceAdjustment Float    // e.g. 560 or -50
  sku             String?
  createdAt       DateTime @default(now())

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
  invoiceLines      InvoiceLine[]

  @@index([productId])
}

model Plan {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  price              Float
  billingPeriod      String   // DAILY, WEEKLY, MONTHLY, YEARLY
  minQuantity        Int      @default(1)
  availableFrom      DateTime
  availableTo        DateTime
  autoCloseAtEndDate Boolean  @default(false)
  allowEarlyClose    Boolean  @default(true)
  allowPause         Boolean  @default(true)
  allowRenewal       Boolean  @default(true)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subscriptions Subscription[]
  templateLines QuotationTemplateLine[]

  @@index([code])
  @@index([billingPeriod])
  @@index([active])
}

model QuotationTemplate {
  id           String   @id @default(uuid())
  name         String
  validityDays Int      @default(30)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines QuotationTemplateLine[]

  @@index([name])
}

model QuotationTemplateLine {
  id         String  @id @default(uuid())
  templateId String
  productId  String
  variantId  String?
  planId     String?
  quantity   Int     @default(1)
  unitPrice  Float
  notes      String?

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  plan     Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([templateId])
}

model Subscription {
  id                 String    @id @default(uuid())
  subscriptionNumber String    @unique // e.g. "SUB-2026-0001"
  customerId         String
  planId             String
  status             String    @default("DRAFT") // DRAFT, QUOTATION, CONFIRMED, ACTIVE, CLOSED
  startDate          DateTime
  expiryDate         DateTime
  paymentTerms       String    @default("NET30") // IMMEDIATE, NET15, NET30, NET60
  nextBillingDate    DateTime
  pauseDate          DateTime?
  discountId         String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan          Plan                        @relation(fields: [planId], references: [id], onDelete: Restrict)
  discount      Discount?                   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  lines         SubscriptionLine[]
  statusHistory SubscriptionStatusHistory[]
  invoices      Invoice[]

  @@index([status])
  @@index([customerId])
  @@index([planId])
  @@index([nextBillingDate])
  @@index([expiryDate])
}

model SubscriptionLine {
  id             String  @id @default(uuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int     @default(1)
  unitPrice      Float
  taxRate        Float   @default(0) // snapshot tax rate %
  amount         Float

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
}

model SubscriptionStatusHistory {
  id             String   @id @default(uuid())
  subscriptionId String
  fromStatus     String
  toStatus       String
  changedById    String?
  reason         String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([createdAt])
}

model TaxRule {
  id             String   @id @default(uuid())
  name           String   // e.g. "Standard VAT", "Digital Services Tax"
  ratePercent    Float    // e.g. 15.0 for 15%
  appliesToType  String   @default("ALL") // ALL, SERVICE, PHYSICAL, DIGITAL
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([appliesToType])
  @@index([active])
}

model Discount {
  id                 String    @id @default(uuid())
  code               String    @unique // e.g. "PROMO20"
  type               String    // FIXED, PERCENTAGE
  value              Float     // e.g. 20 (for 20% or $20)
  minPurchase        Float     @default(0)
  minQuantity        Int       @default(0)
  startDate          DateTime
  endDate            DateTime
  maxUsageCount      Int       @default(0) // 0 = unlimited
  usageCount         Int       @default(0)
  appliesToProductId String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appliesToProduct Product?       @relation(fields: [appliesToProductId], references: [id], onDelete: SetNull)
  subscriptions    Subscription[]
  invoices         Invoice[]

  @@index([code])
  @@index([active])
}

model Invoice {
  id                 String    @id @default(uuid())
  invoiceNumber      String    @unique // e.g. "INV-2026-0001"
  subscriptionId     String?
  customerId         String
  billingPeriod      String    // e.g. "2026-10" or "2026-10-31" (idempotency key part)
  status             String    @default("DRAFT") // DRAFT, CONFIRMED, PAID, CANCELLED
  issuedDate         DateTime  @default(now())
  dueDate            DateTime
  subtotal           Float
  taxTotal           Float
  discountTotal      Float     @default(0)
  totalAmount        Float
  paidAmount         Float     @default(0)
  sentAt             DateTime?
  discountId         String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discount     Discount?     @relation(fields: [discountId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([subscriptionId, billingPeriod])
  @@index([status])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([dueDate])
  @@index([billingPeriod])
}

model InvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String
  productId       String?
  variantId       String?
  description     String
  quantity        Int
  unitPrice       Float
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  discountAmount  Float   @default(0)
  lineTotal       Float
  taxSnapshotJson String? // Snapshot of tax rule details applied to this line

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  amount        Float
  paymentMethod String   // CREDIT_CARD, BANK_TRANSFER, STRIPE, CASH, CHECK
  paymentDate   DateTime @default(now())
  reference     String?  // Transaction reference / cheque number
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String   // e.g. "AUTH_LOGIN", "SUBSCRIPTION_STATUS_CHANGE", "PAYMENT_RECORDED"
  entity      String   // e.g. "Subscription", "Invoice", "Discount"
  entityId    String?
  payloadJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
